{{> head}}
<body class="bg-slate-100 page-body">
  <div class="min-h-screen lg:flex lg:h-screen">
    {{> aside activeDashboard=true isAdmin=isAdmin isStaff=isStaff userName=userName userRole=userRole}}
    <main class="flex-1 overflow-y-auto p-6 lg:p-10">
      {{> notifications}}
      <div class="mx-auto max-w-6xl">

        <!-- Header -->
        <div class="mb-8">
          <p class="text-sm font-bold uppercase tracking-widest text-dali-600">DALICheck</p>
          <h1 class="mt-2 text-4xl font-bold text-slate-900">Overview</h1>
          <p class="mt-1 text-slate-500">Product quality &amp; expiration monitoring at a glance.</p>
        </div>

        <!-- Stat cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-3">Total Products</p>
            <p class="text-4xl font-black text-slate-900">{{total}}</p>
          </div>
          <div class="bg-white rounded-2xl border border-emerald-200 p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-3">Good Condition</p>
            <p class="text-4xl font-black text-emerald-600">{{good}}</p>
          </div>
          <div class="bg-amber-50 rounded-2xl border border-amber-200 p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-amber-700 mb-3">Near Expiry</p>
            <p class="text-4xl font-black text-amber-600">{{warning}}</p>
            <p class="text-xs text-amber-600 mt-1">Within 7 days</p>
          </div>
          <div class="bg-red-50 rounded-2xl border border-red-200 p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-red-600 mb-3">Expired</p>
            <p class="text-4xl font-black text-red-600">{{expired}}</p>
          </div>
        </div>

        <div class="grid lg:grid-cols-2 gap-6">
          <!-- Near Expiry -->
          <section class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
              <div>
                <h2 class="font-bold text-slate-900">Near Expiry</h2>
                <p class="text-xs text-slate-500 mt-0.5">Expiring within 7 days</p>
              </div>
              <a href="/monitor?filter=warning" class="text-xs font-semibold text-dali-600 hover:underline">View all</a>
            </div>
            {{#if nearExpiry.length}}
              <div class="divide-y divide-slate-50">
                {{#each nearExpiry}}
                  <div class="flex items-center gap-3 px-6 py-3.5">
                    {{#if image}}
                      <img src="{{image}}" alt="{{name}}" class="h-10 w-10 rounded-lg object-cover shrink-0">
                    {{else}}
                      <div class="h-10 w-10 rounded-lg bg-dali-100 grid place-items-center text-dali-600 shrink-0 text-lg">&#9634;</div>
                    {{/if}}
                    <div class="flex-1 min-w-0">
                      <p class="font-semibold text-sm text-slate-900 truncate">{{name}}</p>
                      <p class="text-xs text-slate-500">{{category}} &bull; Exp: {{expirationDate}}</p>
                    </div>
                    <span class="shrink-0 rounded-full px-3 py-1 text-xs font-bold bg-amber-100 text-amber-800">
                      {{daysLeft}}d left
                    </span>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="px-6 py-10 text-center text-slate-400 text-sm">No products expiring in the next 7 days.</p>
            {{/if}}
          </section>

          <!-- Recently Expired -->
          <section class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
              <div>
                <h2 class="font-bold text-slate-900">Recently Expired</h2>
                <p class="text-xs text-slate-500 mt-0.5">Requires immediate attention</p>
              </div>
              <a href="/monitor?filter=expired" class="text-xs font-semibold text-dali-600 hover:underline">View all</a>
            </div>
            {{#if recentExpired.length}}
              <div class="divide-y divide-slate-50">
                {{#each recentExpired}}
                  <div class="flex items-center gap-3 px-6 py-3.5">
                    {{#if image}}
                      <img src="{{image}}" alt="{{name}}" class="h-10 w-10 rounded-lg object-cover shrink-0">
                    {{else}}
                      <div class="h-10 w-10 rounded-lg bg-red-100 grid place-items-center text-red-500 shrink-0 text-lg">!</div>
                    {{/if}}
                    <div class="flex-1 min-w-0">
                      <p class="font-semibold text-sm text-slate-900 truncate">{{name}}</p>
                      <p class="text-xs text-slate-500">{{category}} &bull; Exp: {{expirationDate}}</p>
                    </div>
                    <span class="shrink-0 rounded-full px-3 py-1 text-xs font-bold bg-red-100 text-red-700">
                      {{daysAgo}}d ago
                    </span>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="px-6 py-10 text-center text-slate-400 text-sm">No expired products found.</p>
            {{/if}}
          </section>
        </div>

        <!-- Quick actions -->
        <div class="mt-6 grid sm:grid-cols-3 gap-4">
          {{#if isAdmin}}
            <a href="/admin" class="flex items-center gap-4 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition hover:-translate-y-0.5">
              <div class="grid h-11 w-11 place-items-center rounded-xl bg-dali-100 text-dali-600 text-2xl shrink-0">&#9634;</div>
              <div><p class="font-bold text-slate-900 text-sm">Manage Products</p><p class="text-xs text-slate-500 mt-0.5">Add, edit, and delete items</p></div>
            </a>
          {{/if}}
          <a href="/monitor" class="flex items-center gap-4 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition hover:-translate-y-0.5">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-amber-100 text-amber-600 text-2xl shrink-0">&#9888;</div>
            <div><p class="font-bold text-slate-900 text-sm">Expiry Monitor</p><p class="text-xs text-slate-500 mt-0.5">Full expiration report</p></div>
          </a>
          <a href="/products" class="flex items-center gap-4 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition hover:-translate-y-0.5">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-emerald-100 text-emerald-600 text-2xl shrink-0">&#9783;</div>
            <div><p class="font-bold text-slate-900 text-sm">All Products</p><p class="text-xs text-slate-500 mt-0.5">Browse the full catalog</p></div>
          </a>
        </div>

      </div>
    </main>
  </div>
{{> footer}}
