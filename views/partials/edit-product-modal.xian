<div id="edit-modal-{{id}}" data-edit-modal class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4 opacity-0 transition-opacity duration-200" aria-hidden="true">
  <div class="w-full max-w-2xl max-h-[90vh] overflow-y-auto translate-y-4 rounded-3xl bg-white p-6 shadow-2xl transition-transform duration-200" data-modal-panel>
    <div class="mb-5 flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-dali-600">Product Editor</p>
        <h2 class="mt-1 text-xl font-bold text-slate-900">Edit: {{name}}</h2>
      </div>
      <button type="button" data-close-edit class="rounded-full w-9 h-9 text-xl text-slate-400 hover:bg-slate-100 hover:text-slate-900">&times;</button>
    </div>
    <form action="/admin/products/{{id}}/update" method="POST" enctype="multipart/form-data" class="grid grid-cols-2 gap-4">
      <label class="col-span-2 text-sm font-semibold text-slate-700">Product Name
        <input name="name" value="{{name}}" required class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Category
        <input name="category" value="{{category}}" required class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Supplier
        <input name="supplier" value="{{supplier}}" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Price (₱)
        <input name="price" type="number" min="0" step="0.01" value="{{price}}" required class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Stock
        <input name="stock" type="number" min="0" value="{{stock}}" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Barcode
        <input name="barcode" value="{{barcode}}" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Quality Status
        <select name="qualityStatus" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
          <option value="good"     {{#if (eq qualityStatus 'good')}}selected{{/if}}>Good</option>
          <option value="warning"  {{#if (eq qualityStatus 'warning')}}selected{{/if}}>Near Expiry</option>
          <option value="expired"  {{#if (eq qualityStatus 'expired')}}selected{{/if}}>Expired</option>
          <option value="recalled" {{#if (eq qualityStatus 'recalled')}}selected{{/if}}>Recalled</option>
        </select>
      </label>
      <label class="text-sm font-semibold text-slate-700">Manufactured Date
        <input name="manufacturedDate" type="date" value="{{manufacturedDate}}" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="text-sm font-semibold text-slate-700">Expiration Date
        <input name="expirationDate" type="date" value="{{expirationDate}}" required class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">
      </label>
      <label class="col-span-2 text-sm font-semibold text-slate-700">Description
        <textarea name="description" rows="2" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 focus:border-dali-500 outline-none">{{description}}</textarea>
      </label>
      <label class="col-span-2 text-sm font-semibold text-slate-700">Replace Image
        <input name="image" type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full text-sm">
      </label>
      <div class="col-span-2 flex gap-3 justify-end mt-2">
        <button type="button" data-close-edit class="rounded-xl border border-slate-200 px-4 py-2.5 font-semibold text-slate-600 hover:bg-slate-100">Cancel</button>
        <button class="rounded-xl bg-dali-600 px-5 py-2.5 font-semibold text-white hover:bg-dali-700">Save changes</button>
      </div>
    </form>
  </div>
</div>
