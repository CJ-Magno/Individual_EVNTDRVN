{{> head}}
<body class="bg-slate-100 page-body">
  <div class="min-h-screen lg:flex lg:h-screen">
    {{> aside activeMonitor=true isAdmin=isAdmin isStaff=isStaff userName=userName userRole=userRole}}
    <main class="flex-1 overflow-y-auto p-6 lg:p-10">
      {{> notifications}}
      <div class="mx-auto max-w-7xl">

        <!-- Header -->
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-widest text-dali-600">DALICheck</p>
            <h1 class="mt-2 text-4xl font-bold text-slate-900">Expiry Monitor</h1>
            <p class="mt-1 text-slate-500">Track and manage product expiration across the store.</p>
          </div>
        </div>

        <!-- Filter tabs -->
        <div class="flex gap-2 mb-6 flex-wrap">
          <a href="/monitor"                 class="rounded-full px-4 py-2 text-sm font-semibold border transition {{#if (eq filter 'all')}}bg-dali-600 text-white border-dali-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-dali-400{{/if}}">All</a>
          <a href="/monitor?filter=good"     class="rounded-full px-4 py-2 text-sm font-semibold border transition {{#if (eq filter 'good')}}bg-emerald-600 text-white border-emerald-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-emerald-400{{/if}}">Good</a>
          <a href="/monitor?filter=warning"  class="rounded-full px-4 py-2 text-sm font-semibold border transition {{#if (eq filter 'warning')}}bg-amber-500 text-white border-amber-500{{else}}bg-white text-slate-600 border-slate-200 hover:border-amber-400{{/if}}">Near Expiry</a>
          <a href="/monitor?filter=expired"  class="rounded-full px-4 py-2 text-sm font-semibold border transition {{#if (eq filter 'expired')}}bg-red-600 text-white border-red-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-red-400{{/if}}">Expired</a>
          <a href="/monitor?filter=recalled" class="rounded-full px-4 py-2 text-sm font-semibold border transition {{#if (eq filter 'recalled')}}bg-purple-600 text-white border-purple-600{{else}}bg-white text-slate-600 border-slate-200 hover:border-purple-400{{/if}}">Recalled</a>
        </div>

        <!-- Table -->
        <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
          {{#if products.length}}
            <div class="overflow-x-auto">
              <table class="w-full min-w-[820px] text-left">
                <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                  <tr>
                    <th class="px-5 py-4">Product</th>
                    <th class="px-5 py-4">Category</th>
                    <th class="px-5 py-4">Barcode</th>
                    <th class="px-5 py-4">Expiration</th>
                    <th class="px-5 py-4">Status</th>
                    <th class="px-5 py-4">Stock</th>
                    {{#if isAdmin}}<th class="px-5 py-4">Actions</th>{{/if}}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {{#each products}}
                    <tr class="hover:bg-slate-50 transition">
                      <td class="px-5 py-4">
                        <div class="flex items-center gap-3">
                          {{#if image}}
                            <img src="{{image}}" alt="{{name}}" class="h-10 w-10 rounded-lg object-cover shrink-0">
                          {{else}}
                            <div class="h-10 w-10 rounded-lg bg-dali-100 grid place-items-center text-dali-500 shrink-0 font-bold">D</div>
                          {{/if}}
                          <div>
                            <p class="font-semibold text-sm text-slate-900">{{name}}</p>
                            <p class="text-xs text-slate-400">{{supplier}}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-5 py-4 text-sm text-slate-600">{{category}}</td>
                      <td class="px-5 py-4 text-sm text-slate-500 font-mono">{{barcode}}</td>
                      <td class="px-5 py-4">
                        <p class="text-sm font-semibold text-slate-900">{{expirationDate}}</p>
                        {{#if isExpired}}
                          <p class="text-xs text-red-500">Expired {{daysLeft}}d ago</p>
                        {{else if isWarning}}
                          <p class="text-xs text-amber-600">{{daysLeft}} day(s) left</p>
                        {{else}}
                          <p class="text-xs text-emerald-600">{{daysLeft}} day(s) left</p>
                        {{/if}}
                      </td>
                      <td class="px-5 py-4">
                        {{#if isRecalled}}
                          <span class="rounded-full px-3 py-1 text-xs font-bold status-recalled">Recalled</span>
                        {{else if isExpired}}
                          <span class="rounded-full px-3 py-1 text-xs font-bold status-expired">Expired</span>
                        {{else if isWarning}}
                          <span class="rounded-full px-3 py-1 text-xs font-bold status-warning">Near Expiry</span>
                        {{else}}
                          <span class="rounded-full px-3 py-1 text-xs font-bold status-good">Good</span>
                        {{/if}}
                      </td>
                      <td class="px-5 py-4 text-sm text-slate-700 font-semibold">{{stock}}</td>
                      {{#if isAdmin}}
                        <td class="px-5 py-4">
                          <div class="flex gap-2">
                            <button type="button" data-open-edit="{{id}}" class="rounded-lg bg-dali-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-dali-700">Edit</button>
                          </div>
                          {{> edit-product-modal}}
                        </td>
                      {{/if}}
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="px-6 py-16 text-center">
              <div class="text-5xl mb-4">&#10003;</div>
              <p class="text-slate-500">No products match this filter.</p>
            </div>
          {{/if}}
        </section>
      </div>
    </main>
  </div>
  <script>
    document.addEventListener("click", e => {
      const open  = e.target.closest("[data-open-edit]");
      const close = e.target.closest("[data-close-edit]");
      const backdrop = e.target.matches("[data-edit-modal]");
      const modal = open ? document.getElementById(`edit-modal-${open.dataset.openEdit}`)
                  : close?.closest("[data-edit-modal]") || (backdrop ? e.target : null);
      if (!modal) return;
      if (open) {
        modal.classList.remove("hidden");
        requestAnimationFrame(() => { modal.classList.add("flex","opacity-100"); modal.querySelector("[data-modal-panel]").classList.remove("translate-y-4"); });
      } else {
        modal.classList.remove("flex","opacity-100"); modal.classList.add("hidden");
        modal.querySelector("[data-modal-panel]").classList.add("translate-y-4");
      }
    });
    document.addEventListener("keydown", e => {
      if (e.key !== "Escape") return;
      document.querySelectorAll("[data-edit-modal].flex").forEach(m => { m.classList.remove("flex","opacity-100"); m.classList.add("hidden"); });
    });
  </script>
{{> footer}}
