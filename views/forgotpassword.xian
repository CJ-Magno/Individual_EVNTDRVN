{{> head}}
<body class="min-h-screen flex items-center justify-center bg-dali-50 px-4">
  <div class="w-full max-w-md">
    <div class="flex items-center gap-3 justify-center mb-8">
      <div class="grid h-11 w-11 place-items-center rounded-xl text-white font-black text-xl shadow-lg" style="background:#C4136A;">D</div>
      <span class="font-bold text-lg text-slate-900">DALICheck</span>
    </div>
    <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-dali-600 mb-1">Account Recovery</p>
      <h1 class="text-2xl font-bold text-slate-900 mb-1">Reset your password</h1>
      <p class="text-slate-500 text-sm mb-6">Enter your registered email and choose a new password.</p>
      <form method="POST" action="/forgot-password" class="grid gap-4">
        <label class="text-sm font-semibold text-slate-700">Email Address
          <input type="email" name="email" required class="mt-1 block w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-dali-500">
        </label>
        <label class="text-sm font-semibold text-slate-700">New Password
          <input type="password" name="password" minlength="6" required class="mt-1 block w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-dali-500">
        </label>
        <button type="submit" class="w-full rounded-xl p-3 font-semibold text-white text-sm" style="background:#C4136A;">Reset password</button>
      </form>
      <a href="/login" class="block text-center text-dali-600 font-semibold text-sm mt-5">Back to sign in</a>
    </div>
  </div>
{{> footer}}
