{{> head}}
<body class="min-h-screen flex items-center justify-center bg-dali-50 px-4 py-12">
  <div class="w-full max-w-md">
    <div class="flex items-center gap-3 justify-center mb-8">
      <div class="grid h-11 w-11 place-items-center rounded-xl text-white font-black text-xl shadow-lg" style="background:#C4136A;">D</div>
      <div>
        <div class="font-bold text-lg text-slate-900 leading-none">DALICheck</div>
        <div class="text-xs text-slate-500">Everyday Grocery Monitor</div>
      </div>
    </div>
    <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-dali-600 mb-1">New account</p>
      <h1 class="text-2xl font-bold text-slate-900 mb-1">Create your account</h1>
      <p class="text-slate-500 text-sm mb-6">Fill in your details to get started.</p>
      <form method="POST" action="/register" class="grid gap-4">
        <label class="text-sm font-semibold text-slate-700">Full Name
          <input type="text" name="name" placeholder="Juan dela Cruz" required
            class="mt-1 block w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-dali-500">
        </label>
        <label class="text-sm font-semibold text-slate-700">Email Address
          <input type="email" name="email" placeholder="you@dali.com" required
            class="mt-1 block w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-dali-500">
        </label>
        <label class="text-sm font-semibold text-slate-700">Password
          <input type="password" name="password" placeholder="At least 6 characters" minlength="6" required
            class="mt-1 block w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-dali-500">
        </label>
        <label class="text-sm font-semibold text-slate-700">Account Type
          <select name="role" class="mt-1 block w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-dali-500">
            <option value="customer">Customer</option>
            <option value="staff">Staff</option>
            <option value="admin">Administrator</option>
          </select>
        </label>
        <button type="submit" class="w-full rounded-xl p-3 font-semibold text-white text-sm mt-1" style="background:#C4136A;">Create account</button>
      </form>
      <a href="/login" class="block text-center text-dali-600 font-semibold text-sm mt-5">Already have an account? Sign in</a>
    </div>
  </div>
{{> footer}}
